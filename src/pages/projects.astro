---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ServiceHero from '@components/services/ServiceHero.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import CtaBanner from '@components/ui/CtaBanner.astro';
import pottersHouse from '@assets/images/projects/thumbnails/potters-house-church.jpeg';
import { getProjects, projectUrl } from '@lib/content';
import { MQ } from '@config/breakpoints';

interface Card {
  title: string;
  summary: string;
  href: string;
  image: ImageMetadata;
  external?: boolean;
}

const projects = await getProjects();
const cards: Card[] = [
  ...projects.map((project) => ({
    title: project.data.title,
    summary: project.data.summary ?? project.data.tagline,
    href: projectUrl(project),
    image: project.data.thumbnail,
  })),
  {
    title: 'Potters House Church',
    summary: 'For we are His workmanship, created in Christ Jesus for good works | EPH.2.10',
    href: 'https://phlive.london/',
    image: pottersHouse,
    external: true,
  },
];
---

<BaseLayout
  title="Projects"
  description="In this space you’ll find a selection of projects worked on by Baya Garden studio. Whether it’s design, strategy or integration with third party applications,"
>
  <ServiceHero
    eyebrow="Selection of work"
    title="Projects"
    size="small"
    ruled
    introWidth="wide"
    intro="In this space you’ll find a selection of projects worked on by Baya Garden studio. Whether it’s design, strategy or integration with third party applications, we’ve got you covered."
  />
  <div class="projects">

    <ul class="projects__list" role="list">
      {
        cards.map((card) => (
          <li class="card">
            <Image src={card.image} alt="" widths={[400, 640, 900]} sizes={`${MQ.mdDown} 100vw, 50vw`} class="card__image" />
            <div class="card__text">
              <h2>{card.title}</h2>
              <p>{card.summary}</p>
              <Button
                href={card.href}
                variant="dark"
                size="slim"
                arrow
                {...(card.external && { target: '_blank', rel: 'noopener noreferrer' })}
              >
                View project<span class="sr-only">: {card.title}{card.external && ' (opens in a new tab)'}</span>
              </Button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <CtaBanner size="small" title="Baya Garden Studio will support you every step of the way and give you peace of mind knowing that your business is primed for growth." />
</BaseLayout>

<style>
  .projects {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-md) var(--space-md) var(--space-xl);
  }

  .projects__list {
    display: grid;
    margin: 0;
    padding: var(--space-xl) 0 0;
    gap: var(--space-md);
    list-style: none;
  }

  /* Thick dark frame, as on the live site; the image fills the left half. */
  .card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    border: var(--border-showcase) solid var(--color-text);
    border-radius: 1.8em;
    box-shadow: var(--shadow-photo);

    @media (--md-down) {
      grid-template-columns: 1fr;
    }
  }

  .card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 1.2em;

    /* Stacked on phones, the image sits inset in its own panel. */
    @media (--md-down) {
      width: calc(100% - 2em);
      margin: 1em;
    }
  }

  .card__text {
    padding: var(--space-md);
  }

  h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    text-transform: none;
  }

  .card__text p {
    max-width: 19em;
    margin: var(--stack-s) 0 var(--space-sm);
  }
</style>
