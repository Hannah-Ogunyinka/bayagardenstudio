---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import CtaBanner from '@components/ui/CtaBanner.astro';
import pottersHouse from '@assets/images/projects/thumbnails/potters-house-church.jpeg';
import { getProjects, projectUrl } from '@lib/content';

interface Card {
  title: string;
  summary: string;
  href: string;
  image: ImageMetadata;
  external?: boolean;
}

const projects = await getProjects();
const cards: Card[] = [
  ...projects.map((project) => ({
    title: project.data.title,
    summary: project.data.summary ?? project.data.tagline,
    href: projectUrl(project),
    image: project.data.thumbnail,
  })),
  {
    title: 'Potters House Church',
    summary: 'For we are His workmanship, created in Christ Jesus for good works | EPH.2.10',
    href: 'https://phlive.london/',
    image: pottersHouse,
    external: true,
  },
];
---

<BaseLayout
  title="Projects"
  description="In this space you’ll find a selection of projects worked on by Baya Garden studio. Whether it’s design, strategy or integration with third party applications,"
>
  <div class="projects">
    <header class="projects__header">
      <p class="eyebrow">Selection of work</p>
      <h1>Projects</h1>
      <p class="projects__intro">
        In this space you’ll find a selection of projects worked on by Baya Garden studio. Whether it’s design, strategy
        or integration with third party applications, we’ve got you covered.
      </p>
    </header>

    <ul class="projects__list" role="list">
      {
        cards.map((card) => (
          <li class="card">
            <Image src={card.image} alt="" widths={[400, 640, 900]} sizes="(max-width: 782px) 100vw, 50vw" class="card__image" />
            <div class="card__text">
              <h2>{card.title}</h2>
              <p>{card.summary}</p>
              <Button
                href={card.href}
                variant="dark"
                arrow
                {...(card.external && { target: '_blank', rel: 'noopener noreferrer' })}
              >
                View project<span class="sr-only">: {card.title}{card.external && ' (opens in a new tab)'}</span>
              </Button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <CtaBanner size="small" title="Baya Garden Studio will support you every step of the way and give you peace of mind knowing that your business is primed for growth." />
</BaseLayout>

<style>
  .projects {
    max-width: 1300px;
    margin-inline: auto;
    padding: var(--space-md);
  }

  .projects__header {
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-grey-400);
  }

  .eyebrow {
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-grey-400);
    color: var(--color-purple-dark);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    text-align: center;
  }

  .projects__intro {
    max-width: 24rem;
    font-size: var(--text-xs);
  }

  .projects__list {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    align-items: center;
    padding: 0.6rem;
    border: 8px solid var(--color-text);
    border-radius: 24px;

    @media (max-width: 782px) {
      grid-template-columns: 1fr;
    }
  }

  .card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }

  h2 {
    margin-bottom: 0.4rem;
    font-family: var(--font-heading);
    font-size: var(--text-2xl-alt);
    font-weight: 700;
    line-height: 1.1;
    text-transform: none;
  }

  .card__text p {
    max-width: 22rem;
    font-size: var(--text-sm);
  }
</style>
