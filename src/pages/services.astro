---
/**
 * Services overview: a tiled image hero, the three core services as cards,
 * then the Brand Photography panel and the closing call to action.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import CtaBanner from '@components/ui/CtaBanner.astro';
import ScrollDown from '@components/ui/ScrollDown.astro';
import PhotographyPanel from '@components/photography/PhotographyPanel.astro';
import leftTop from '@assets/images/services/left-photography-container.webp';
import leftBottom from '@assets/images/services/left-mobile-container.webp';
import centreTop from '@assets/images/services/centre-mobile-container.webp';
import centreBottom from '@assets/images/services/centre-yoga.webp';
import rightTop from '@assets/images/services/right-cakes.webp';
import rightBottom from '@assets/images/services/right-photography-container.webp';
import { MQ } from '@config/breakpoints';

/** Hero tiles are decorative screenshots of client work, so they carry empty alt text. */
const tiles = [
  { src: centreTop, area: 'centre-top', eager: true },
  { src: leftTop, area: 'left-top', eager: true },
  { src: rightTop, area: 'right-top', eager: true },
  { src: leftBottom, area: 'left-bottom', eager: false },
  { src: rightBottom, area: 'right-bottom', eager: false },
  { src: centreBottom, area: 'centre-bottom', eager: false },
] as const;

const services = [
  {
    name: 'Build',
    subtitle: 'Web design and development',
    text: 'For the high flyer that wants to turn up looking their best online, greet prospective clients with a polished, strategically crafted digital base that shows you mean business.',
    href: '/website-design-and-development/',
  },
  {
    name: 'Support',
    subtitle: 'Website care plans',
    text: 'Keep your website up to date, backed up and running smoothly with a Set and Forget website care plan.',
    href: '/website-care-plan/',
  },
  {
    name: 'Grow',
    subtitle: 'Marketing and automation',
    text: 'End the frustration that comes with slow sales and an ineffective growth strategy and start building an audience ready to purchase by working with Baya Garden Studio.',
    href: '/marketing-and-automation/',
  },
] as const;
---

<BaseLayout
  title="Services"
  description="Web design and development, website care plans, marketing and automation, and brand photography for creative businesses from Baya Garden Studio."
>
  <section class="hero" aria-labelledby="services-title">
    <div class="hero__grid">
      {
        tiles.map(({ src, area, eager }) => (
          <Image
            src={src}
            alt=""
            widths={[400, 640, 1012]}
            sizes={`${MQ.lgDown} 100vw, 36vw`}
            loading={eager ? 'eager' : 'lazy'}
            class:list={['hero__tile', `hero__tile--${area}`]}
          />
        ))
      }
      <div class="hero__title-tile">
        <h1 id="services-title">Services</h1>
        <div class="hero__scroll"><ScrollDown href="#our-services" /></div>
      </div>
    </div>
  </section>

  <section id="our-services" class="services" aria-label="Our services">
    <ul class="services__list" role="list">
      {
        services.map(({ name, subtitle, text, href }) => (
          <li class="service-card">
            <h2>{name}</h2>
            <p class="service-card__subtitle">{subtitle}</p>
            <p class="service-card__text">{text}</p>
            <Button href={href} variant="dark" arrow>
              Go to {name.toLowerCase()}
            </Button>
          </li>
        ))
      }
    </ul>

    <PhotographyPanel packagesHref="/brand-photography/" />
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  /*
   * Tiled hero, measured from the live site. Three columns of client-work tiles
   * (1012 × 806 screenshots); the centre column sits half a tile higher and the
   * grid starts under the header, so the top row is cropped.
   */
  .hero {
    --gap: 2em;
    --header-h: var(--header-height);
    --tile-w: calc((108.5vw - 2 * var(--gap)) / 3);
    --tile-h: calc(var(--tile-w) * 0.7976);

    display: flow-root; /* keeps the grid's negative margin inside the hero */
    overflow: clip;
    margin-top: calc(-1 * var(--header-h));
    margin-bottom: calc(var(--tile-h) * 0.78);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(3, var(--tile-w));
    grid-auto-rows: calc((var(--tile-h) - var(--gap)) / 2);
    grid-template-areas:
      '.           centre-top    .'
      'left-top    centre-top    right-top'
      'left-top    title         right-top'
      'left-bottom title         right-bottom'
      'left-bottom centre-bottom right-bottom'
      '.           centre-bottom .';
    gap: var(--gap);
    margin-top: calc(-0.5 * (var(--tile-h) + var(--gap)));
    margin-left: -2.85vw;
  }

  .hero__tile {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__tile--centre-top {
    grid-area: centre-top;
  }

  .hero__tile--left-top {
    grid-area: left-top;
  }

  .hero__tile--right-top {
    grid-area: right-top;
  }

  .hero__tile--left-bottom {
    grid-area: left-bottom;
  }

  .hero__tile--right-bottom {
    grid-area: right-bottom;
  }

  .hero__tile--centre-bottom {
    grid-area: centre-bottom;
  }

  .hero__title-tile {
    display: flex;
    grid-area: title;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    border-radius: var(--radius-panel);
    background-color: var(--color-grey-200);
  }

  .hero__scroll {
    align-self: flex-end;
    margin-inline-end: 10%;
    padding-block: var(--space-sm) var(--space-md);
  }

  h1 {
    margin: 0;
    font-size: var(--text-services-title);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    text-transform: capitalize;
  }

  /* Phones and tablets: only the centre column, stacked. */
  @media (--lg-down) {
    .hero {
      --header-h: 0;
      --top-h: calc((109vw - var(--gap)) * 0.7944);

      margin-bottom: calc(14vw + 9rem); /* token-exempt: space under the hero, measured from the live site */
    }

    .hero__grid {
      display: flex;
      flex-direction: column;
      gap: var(--gap);
      margin: 0;
    }

    .hero__tile--left-top,
    .hero__tile--right-top,
    .hero__tile--left-bottom,
    .hero__tile--right-bottom {
      display: none;
    }

    /* Only the bottom of this tile shows: 39px on a phone, more on a tablet. */
    .hero__tile--centre-top {
      order: 1;
      width: calc(109vw - var(--gap));
      height: var(--top-h);
      max-width: none;
      margin-top: calc(45vw - 5.2rem - var(--top-h) - var(--gap)); /* token-exempt: crop of the top tile, measured from the live site */
      margin-left: var(--gap);
    }

    .hero__title-tile {
      order: 2;
      width: 85%;
      min-height: 24em;
      margin-inline: auto;
    }

    .hero__tile--centre-bottom {
      order: 3;
      width: calc(109vw - 2 * var(--gap));
      height: auto;
      max-width: none;
      aspect-ratio: 1012 / 806;
    }
  }

  /* Service cards */
  .services {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: calc(var(--space-sm) + var(--space-md));
    padding-bottom: var(--space-2xl);
  }

  .services__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;

    @media (--md-down) {
      grid-template-columns: 1fr;
    }
  }

  .service-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 1.28em;
    padding: var(--space-md);
    border-radius: var(--radius-panel);
    background-color: var(--color-grey-200);
    text-align: center;
  }

  .service-card h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
  }

  /* Darker purple than the live site so the subtitle passes contrast on grey. */
  .service-card__subtitle {
    margin: 0;
    padding-block: var(--space-sm);
    color: var(--color-accent-strong);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    line-height: var(--leading-normal);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .service-card__text {
    flex-grow: 1;
    margin: 0;
  }
</style>
