---
/**
 * Grow: marketing and automation. Service hero, dark intro band,
 * three outcome panels, then a closing line and call to action.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import ServiceHero from '@components/services/ServiceHero.astro';
import IntroBand from '@components/services/IntroBand.astro';
import phone from '@assets/images/services/mobile-on-red-background.webp';

const outcomes = [
  {
    title: 'Build an engaged audience',
    text: 'Baya Garden’s Grow strategy offers a comprehensive approach to audience engagement, leveraging email, content marketing and technical SEO to connect with and retain your target audience. We’ll come up with a personalised plan for your business that ensures that your audience aren’t just spectators, but active participants in your brand’s journey.',
  },
  {
    title: 'Build credibility and become a thought leader',
    text: 'Nurture your audience and build trust by adopting a Baya Garden growth strategy that is tailored to your business and specific industry. The growth strategy provides you with a plan to empower your community with valuable content, while efficiently collecting success stories and reviews to strengthen your position as a thought leader in your industry.',
  },
  {
    title: 'Build efficient workflows',
    text: 'Remove barriers to growth and inefficient workflows by establishing standard operating procedures to speed up repetitive tasks. Baya Garden Studio will help you to identify repetitive and time consuming tasks and build automations and guides that will free up time and accelerate growth.',
  },
] as const;
---

<BaseLayout
  title="Marketing and Automation"
  description="Marketing and automation for creative businesses: build an engaged audience, earn credibility and set up efficient workflows that free up time to grow."
>
  <ServiceHero
    eyebrow="Marketing and automation"
    title="Grow"
    intro="End the frustration that comes with slow sales and an ineffective growth strategy and start building an audience ready to purchase by working with Baya Garden Studio."
  />

  <IntroBand image={phone}>
    <p>
      It can be frustrating to see the business you’ve worked hard to build struggling with slow growth. You want to see
      your expertise serve a wider audience but you’re not sure how to get the reach you need or how to convert your
      audience from curious spectators to happy customers.
    </p>
    <p>Propel your business forward and gain clarity with a comprehensive growth strategy.</p>
    <p>Baya Garden Studio can help you to:</p>
  </IntroBand>

  <div class="grow">
  <ul class="outcomes" role="list">
    {
      outcomes.map(({ title, text }) => (
        <li class="outcome">
          <h2>{title}</h2>
          <p>{text}</p>
        </li>
      ))
    }
  </ul>

  <section class="closing" aria-label="Get started">
    <p>
      Baya Garden Studio will support you every step of the way and give you peace of mind knowing that your business is
      primed for growth.
    </p>
    <Button href="/contact/">Start your project</Button>
  </section>
  </div>
</BaseLayout>

<style>
  .grow {
    display: flex;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-xl) var(--space-md);
    flex-direction: column;
    gap: var(--space-xl);
  }

  .outcomes {
    display: flex;
    margin: 0;
    padding: 0;
    flex-direction: column;
    gap: var(--space-xl);
    list-style: none;
  }

  .outcome {
    display: grid;
    grid-template-columns: 3fr 2fr;
    align-items: start;
    padding: var(--space-md);
    border: var(--border-hairline) solid var(--color-grey-400);
    border-radius: var(--radius-panel);

    @media (--md-down) {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  .outcome h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    text-transform: none;
  }

  .outcome p {
    margin: 0;
  }

  .closing {
    display: flex;
    width: 60%;
    margin-inline: auto;
    padding-block: var(--space-md);
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;

    @media (--md-down) {
      width: 100%;
    }
  }

  .closing p {
    margin: 0;
  }
</style>
