---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/forms/ContactForm.astro';
import grid from '@assets/images/contact/contact-grid.png';
---

<BaseLayout
  title="Contact"
  description="Tell Baya Garden Studio about your project: web design and development, email marketing, website care or brand photography. We'll be in touch."
>
  <div class="contact">
    <h1>Solutions <span class="accent">crafted</span> for Businesses</h1>
    <div class="contact__columns">
      <Image src={grid} alt="" widths={[320, 480, 640]} sizes="(max-width: 782px) 100vw, 40vw" class="contact__image" />
      <div class="contact__form">
        <h2 class="sr-only">Start your project</h2>
        <ContactForm />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-md) var(--space-md) var(--space-xl);
  }

  h1 {
    max-width: 7em;
    margin-left: auto;
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.1;
    text-align: right;
    text-transform: capitalize;
  }

  .accent {
    color: var(--color-purple);
  }

  .contact__columns {
    display: flex;
    gap: var(--space-lg);
    justify-content: space-between;

    > * {
      width: 50%;
    }

    @media (max-width: 782px) {
      flex-direction: column;

      > * {
        width: 100%;
      }
    }
  }

  .contact__image {
    max-width: 420px;
  }

  .contact__form {
    max-width: 480px;
    margin-left: auto;
  }
</style>
