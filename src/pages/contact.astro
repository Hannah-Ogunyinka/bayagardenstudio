---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/forms/ContactForm.astro';
import ContactTree from '@components/contact/ContactTree.astro';
---

<BaseLayout
  title="Contact"
  description="Tell Baya Garden Studio about your project: web design and development, email marketing, website care or brand photography. We'll be in touch."
>
  <div class="contact">
    <h1>Solutions <span class="accent">crafted</span> for Businesses</h1>
    <div class="contact__columns">
      <div class="contact__form">
        <h2 class="sr-only">Start your project</h2>
        <ContactForm />
      </div>
      <div class="contact__tree">
        <ContactTree />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Wider side margins than the rest of the site: about 24px on phones, 77px at
     1280px and up to 112px on large screens. */
  .contact {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-md) clamp(var(--space-md), 6vw, var(--space-2xl)) var(--space-xl);
  }

  /* Theme: a 900px heading box set to the right. On the live site
     "Businesses" overhangs the screen edge at 1920px; here the box widens to
     fit the word instead, so the lines break the same way without overflow. */
  h1 {
    width: min-content;
    min-width: min(100%, var(--measure-contact-title));
    max-width: 100%;
    margin: 0 0 var(--space-md) auto;
    font-size: var(--text-display-sm);
    font-weight: var(--weight-bold);
    line-height: 1.1;
    text-align: right;
    text-transform: capitalize;
  }

  .accent {
    color: var(--color-purple);
  }

  /* The form takes the right half. The tree stands on the form's last line and
     rises above the form, so its top branches sit beside "Businesses". */
  .contact__columns {
    position: relative;
    display: flex;
    justify-content: flex-end;

    /* On phones the tree follows the form. */
    @media (--md-down) {
      flex-direction: column;
    }
  }

  .contact__form {
    position: relative;
    z-index: 1;
    flex: 0 0 calc(50% - var(--space-md) / 2);

    @media (--md-down) {
      flex-basis: auto;
    }
  }

  .contact__tree {
    position: absolute;
    bottom: 0;
    left: 0;
    width: min(calc(50% - 1.5rem), 36rem); /* token-exempt: sized so the branch tips clear "Businesses" at 1440px */
    aspect-ratio: 480 / 720;

    @media (--md-down) {
      position: static;
      width: 100%;
      /* Matches the page's bottom padding, so the tree has even space above and below. */
      margin-top: var(--space-xl);
    }
  }
</style>
