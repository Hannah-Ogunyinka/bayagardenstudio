---
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeHero from '@components/home/HomeHero.astro';
import OfferSection from '@components/home/OfferSection.astro';
import BrandPhotography from '@components/home/BrandPhotography.astro';
import FeaturedPost from '@components/home/FeaturedPost.astro';
import Mission from '@components/home/Mission.astro';
import CtaBanner from '@components/ui/CtaBanner.astro';
---

<BaseLayout
  fullTitle="Focused Web Design and Tech Strategy for Creatives | Baya Garden Studio"
  description="Discover how Baya Garden Studio helps creatives with their web design and tech strategy. Strengthen your online presence and connect with your audience today."
>
  <HomeHero />
  <OfferSection />
  <BrandPhotography />
  <FeaturedPost />
  <Mission />
  <div class="home__cta">
    <CtaBanner />
  </div>
</BaseLayout>

<style>
  /* The theme's closing section adds its own medium padding above the banner on wider screens. */
  .home__cta {
    @media (--md-up) {
      padding-top: var(--space-md);
    }
  }
</style>
