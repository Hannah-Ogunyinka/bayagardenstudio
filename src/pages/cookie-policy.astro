---
import { getEntry, render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';

const entry = await getEntry('pages', 'cookie-policy');
if (!entry) throw new Error('Missing content: pages/cookie-policy');
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} seoTitle={entry.data.seoTitle} description={entry.data.description}>
  <Content />
</PageLayout>
