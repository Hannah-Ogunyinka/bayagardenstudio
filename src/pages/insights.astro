---
/** Insights: featured latest article, then a grid of every article. */
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryTag from '@components/posts/CategoryTag.astro';
import PostCard from '@components/posts/PostCard.astro';
import { formatDate, getPosts, postUrl } from '@lib/content';
import { MQ } from '@config/breakpoints';

const posts = await getPosts();
const [featured] = posts;
---

<BaseLayout title="Insights" description="Practical insights on websites, automation and running a creative business from Baya Garden Studio.">
  <div class="insights">
    <h1>Insights</h1>

    {
      featured && (
        <article class="featured">
          <div class="featured__text">
            {featured.data.categories[0] && <CategoryTag name={featured.data.categories[0]} />}
            <h2>
              <a href={postUrl(featured)}>{featured.data.title}</a>
            </h2>
            <p>
              <time datetime={featured.data.published.toISOString()}>{formatDate(featured.data.published)}</time>
            </p>
          </div>
          <Image
            src={featured.data.image.src}
            alt=""
            widths={[480, 720, 960]}
            sizes={`${MQ.mdDown} 100vw, 50vw`}
            loading="eager"
            class="featured__image"
          />
        </article>
      )
    }

    <section class="further" aria-labelledby="further-insights">
      <h2 id="further-insights" class="insights__subtitle">Further Insights</h2>
      <ul class="insights__grid" role="list">
        {
          posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /* Mirrors the theme's index.html template: medium padding, a 10em title,
     a 40/60 featured post over a rule, then a three-column query grid. */
  .insights {
    /* The theme caps the content, not the padded box, at 1920px. */
    box-sizing: content-box;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-md) var(--space-md) var(--space-xl);
  }

  h1 {
    margin: 0 0 var(--space-md);
    font-size: var(--text-insights-title);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .featured {
    position: relative;
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-md);
    align-items: start;
    /* The theme's columns block adds 1.75em below itself. */
    padding-bottom: calc(var(--space-md) + 1.75em);
    border-bottom: var(--border-hairline) solid var(--color-rule);

    /* Stacked, the theme's columns only keep their horizontal gap. */
    @media (--md-down) {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
  }

  .featured__text {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;

    /* The theme's category tag gains space above it on phones and small tablets. */
    @media (--md-down) {
      padding-top: var(--space-sm);
    }
  }

  .featured h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h2-sm);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
  }

  .featured h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .featured h2 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .featured:hover h2 a {
    color: var(--color-purple);
  }

  .featured :global(.category-tag) {
    position: relative;
    z-index: 1;
  }

  .featured p {
    margin: 0;
  }

  .featured__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
  }

  .further {
    padding-top: var(--space-xl);
  }

  .insights__subtitle {
    margin: 0 0 var(--space-md);
    font-family: var(--font-heading);
    font-size: var(--text-section-title);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
  }

  /* WordPress grid layout, columnCount 3: three columns until each would be
     narrower than 12rem, then one. */
  .insights__grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(max(min(var(--grid-min-xs), 100%), (100% - 2 * var(--space-md)) / 3), 1fr)
    );
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
