---
/** Insights: featured latest article, then a grid of every article. */
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryTag from '@components/posts/CategoryTag.astro';
import PostCard from '@components/posts/PostCard.astro';
import { formatDate, getPosts, postUrl } from '@lib/content';
import { MQ } from '@config/breakpoints';

const posts = await getPosts();
const [featured] = posts;
---

<BaseLayout title="Insights" description="Practical insights on websites, automation and running a creative business from Baya Garden Studio.">
  <div class="insights">
    <h1>Insights</h1>

    {
      featured && (
        <article class="featured">
          <div class="featured__text">
            {featured.data.categories[0] && <CategoryTag name={featured.data.categories[0]} />}
            <h2>
              <a href={postUrl(featured)}>{featured.data.title}</a>
            </h2>
            <p>
              <time datetime={featured.data.published.toISOString()}>{formatDate(featured.data.published)}</time>
            </p>
          </div>
          <Image
            src={featured.data.image.src}
            alt=""
            widths={[480, 720, 960]}
            sizes={`${MQ.mdDown} 100vw, 50vw`}
            loading="eager"
            class="featured__image"
          />
        </article>
      )
    }

    <hr />

    <section aria-labelledby="further-insights">
      <h2 id="further-insights" class="insights__subtitle">Further Insights</h2>
      <ul class="insights__grid" role="list">
        {
          posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .insights {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-md) var(--space-md) var(--space-xl);
  }

  h1 {
    font-size: var(--text-display-sm);
    font-weight: 700;
    line-height: 1.1;
  }

  .featured {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--space-md);
    align-items: start;

    @media (--md-down) {
      grid-template-columns: 1fr;
    }
  }

  .featured__text {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .featured h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.3;
    text-transform: none;
  }

  .featured h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .featured h2 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .featured:hover h2 a {
    color: var(--color-purple);
  }

  .featured :global(.category-tag) {
    position: relative;
    z-index: 1;
  }

  .featured p {
    font-size: var(--text-small);
  }

  .featured__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  hr {
    margin-block: var(--space-lg);
    border: 0;
    border-top: var(--border-hairline) solid var(--color-grey-400);
  }

  .insights__subtitle {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 700;
  }

  .insights__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--grid-min-m)), 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
