---
/**
 * Case study: title, tagline and services, hero image, optional client quote,
 * then sections laid out with the heading on the left and text on the right.
 */
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import CtaBanner from '@components/ui/CtaBanner.astro';
import type { Project } from '@lib/content';
import '@styles/prose.css';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, tagline, services, hero, quote, video, published, updated } = project.data;
---

<BaseLayout title={title} description={description} image={hero.src.src} article={{ published, modified: updated }}>
  <article class="project">
    <header class="project__header">
      <div>
        <a class="back-link" href="/projects/"><span aria-hidden="true">←</span> Back to projects</a>
        <h1>{title}</h1>
        <p class="project__tagline">{tagline}</p>
      </div>
      <div>
        <h2 class="sr-only">What we delivered</h2>
        <ul class="project__services">{services.map((service) => <li>{service}</li>)}</ul>
      </div>
    </header>

    <Image src={hero.src} alt={hero.alt} widths={[640, 960, 1440, 1920]} sizes="(max-width: 1440px) 100vw, 1440px" loading="eager" fetchpriority="high" class="project__hero" />

    <div class:list={['project__body', 'prose', { 'project__body--quote': quote }]}>
      {quote && <blockquote class="project__quote"><p>{quote}</p></blockquote>}
      <slot />
    </div>

    {
      video && (
        <figure class="project__video">
          <video src={video} controls muted playsinline preload="metadata" aria-label={`Screen recording of the ${title} website`} />
        </figure>
      )
    }
  </article>
  <CtaBanner title="Ready to start your own project?" />
</BaseLayout>

<style>
  .project {
    max-width: 1300px;
    margin-inline: auto;
    padding: var(--space-md);
  }

  .project__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .back-link {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-decoration: none;
    text-transform: uppercase;
  }

  .back-link span {
    color: var(--color-purple);
  }

  h1 {
    margin: 0.4rem 0;
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .project__tagline {
    max-width: 16em;
    color: var(--color-purple-dark);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.3;
  }

  .project__services {
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    list-style: none;
  }

  .project__hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Headings sit in the left column, text in the right, images span both. */
  .project__body {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    column-gap: var(--space-xl);
    align-items: start;
    padding-block: var(--space-xl);
    font-size: var(--text-xs);

    @media (max-width: 782px) {
      grid-template-columns: 1fr;
    }
  }

  .project__body > :global(*) {
    grid-column: 2;

    @media (max-width: 782px) {
      grid-column: 1;
    }
  }

  .project__body > :global(h2),
  .project__body > :global(.project__quote) {
    grid-column: 1;
    margin-top: 0;
    font-size: var(--text-xl);
  }

  .project__body > :global(p:has(> img:only-child)) {
    grid-column: 1 / -1;
  }

  .project__body :global(img) {
    border-radius: 0;
  }

  .project__quote {
    margin: 0;
  }

  .project__quote p {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
    text-transform: capitalize;
  }

  .project__video video {
    width: 100%;
    border: 8px solid var(--color-white);
  }

  .project__video {
    margin: 0;
  }
</style>
