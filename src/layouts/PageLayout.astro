---
/** Plain text page (privacy policy, cookie policy). */
import BaseLayout from './BaseLayout.astro';
import '@styles/prose.css';

interface Props {
  title: string;
  seoTitle?: string | undefined;
  description: string;
}

const { title, seoTitle, description } = Astro.props;
---

<BaseLayout title={title} fullTitle={seoTitle} description={description}>
  <article class="page">
    <h1>{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Mirrors the theme's policy pages: medium padding, a 1120px column, an
     extra-bold title, then body-size text with large section headings. */
  .page {
    box-sizing: content-box;
    max-width: var(--container-policy);
    margin-inline: auto;
    padding: var(--space-md);
  }

  h1 {
    margin: 0 0 var(--space-md);
    color: var(--color-black);
    font-size: var(--text-h2-alt);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-snug);
  }

  .page :global(.prose) {
    font-family: var(--font-heading);
    font-size: var(--text-body);
  }

  .page :global(.prose > *) {
    margin: 0 0 var(--space-sm);
  }

  .page :global(.prose > p:first-child) {
    margin-bottom: var(--space-md);
  }

  .page :global(.prose h2) {
    margin-bottom: var(--space-sm);
    color: var(--color-black);
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    text-transform: capitalize;
  }

  .page :global(.prose * + h2) {
    margin-top: var(--space-md);
  }

  .page :global(.prose :is(ul, ol)) {
    padding-left: 2em;
    color: var(--color-black);
  }

  .page :global(.prose li) {
    margin-bottom: 1em;
  }

  .page :global(.prose a) {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
</style>
