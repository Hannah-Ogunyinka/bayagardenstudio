---
/** Plain text page (privacy policy, cookie policy). */
import BaseLayout from './BaseLayout.astro';
import '@styles/prose.css';

interface Props {
  title: string;
  seoTitle?: string | undefined;
  description: string;
}

const { title, seoTitle, description } = Astro.props;
---

<BaseLayout title={title} fullTitle={seoTitle} description={description}>
  <article class="page">
    <h1>{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: var(--measure-2xl);
    margin-inline: auto;
    padding: var(--space-md) var(--space-md) var(--space-xl);
  }

  .page :global(.prose) {
    font-size: var(--text-ui);
  }
</style>
