<style>
  .contact-tree {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Pivots in the 56-unit bird artwork, as in AnimatedLogo. */
  .tree-bird__wing {
    transform-box: view-box;
    transform-origin: 36.6px 20px; /* token-exempt: shoulder pivot in the 56-unit SVG artwork */
  }

  .tree-bird__tail {
    transform-box: view-box;
    transform-origin: 20.2px 35.7px; /* token-exempt: hip pivot in the 56-unit SVG artwork */
  }

  .tree-bird__turn {
    transform-box: view-box;
    transform-origin: 28.5px 38px; /* token-exempt: between the feet in the 56-unit SVG artwork */
  }

  .tree-bird__eye {
    transform-box: view-box;
    transform-origin: 34.33px 11.88px; /* token-exempt: eye centre in the 56-unit SVG artwork */
    animation: tree-bird-blink 4.6s infinite;
  }

  .tree-bird[data-bird='1'] .tree-bird__eye {
    animation-delay: -1.7s;
  }

  .tree-bird[data-bird='2'] .tree-bird__eye {
    animation-duration: 5.3s;
    animation-delay: -3.1s;
  }

  /* Behaviours. The script adds a class and removes it when the animation ends. */
  .tree-bird.is-flying .tree-bird__bob {
    animation: tree-bird-bob 1.4s ease-in-out;
  }

  .tree-bird.is-flying .tree-bird__wing--near {
    animation: tree-bird-flap 1.4s;
  }

  .tree-bird.is-flying .tree-bird__wing--far {
    animation: tree-bird-flap-far 1.4s;
  }

  .tree-bird.is-flying .tree-bird__tail {
    animation: tree-bird-tail 1.4s;
  }

  .tree-bird.is-flicking .tree-bird__tail {
    animation: tree-bird-flick 0.8s ease-out;
  }

  .tree-bird.is-turning .tree-bird__turn {
    animation: tree-bird-turn 1.9s;
  }

  .tree-bird.is-peeking .tree-bird__bob {
    animation: tree-bird-peek 2.2s;
  }

  /* A branch gives under a bird as it takes off, then springs back. Its cloud,
     nest and bird share the branch's class, so they ride along. */
  .tree-branch {
    transform-box: view-box;
  }

  .on-b1 {
    transform-origin: 244px 372px; /* token-exempt: base of the long right branch in the SVG artwork */
  }

  .on-b0 {
    transform-origin: 238px 180px; /* token-exempt: base of the upper right branch in the SVG artwork */
  }

  .contact-tree.dip-b1 .on-b1,
  .contact-tree.dip-b0 .on-b0 {
    animation: tree-branch-dip 1.5s;
  }

  .contact-tree.dip-b1 .on-b1 .tree-cloud__inner,
  .contact-tree.dip-b0 .on-b0 .tree-cloud__inner {
    animation: tree-cloud-shiver 0.9s 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-tree *,
    .contact-tree.dip-b0 *,
    .contact-tree.dip-b1 * {
      animation: none !important;
    }
  }

  /* Front wing: a small dip, then four beats that taper. Each beat pushes down
     fast and recovers slowly, and the wing shortens at the top as it turns. */
  @keyframes tree-bird-flap {
    0%, 4.6% { transform: rotate(0deg) scale(1,1); animation-timing-function: ease-out; }
    11.4% { transform: rotate(-7deg) scale(1,1); animation-timing-function: cubic-bezier(.3,0,.2,1); }
    22.9% { transform: rotate(74deg) scale(.96,.86); animation-timing-function: cubic-bezier(.55,0,.85,.45); }
    26.5% { transform: rotate(42deg) scale(1,1); animation-timing-function: cubic-bezier(.15,.55,.35,1); }
    32% { transform: rotate(68deg) scale(.96,.86); animation-timing-function: cubic-bezier(.55,0,.85,.45); }
    35.7% { transform: rotate(40deg) scale(1,1); animation-timing-function: cubic-bezier(.15,.55,.35,1); }
    41.1% { transform: rotate(60deg) scale(.96,.86); animation-timing-function: cubic-bezier(.55,0,.85,.45); }
    44.8% { transform: rotate(36deg) scale(1,1); animation-timing-function: cubic-bezier(.15,.55,.35,1); }
    50.3% { transform: rotate(52deg) scale(.96,.86); animation-timing-function: cubic-bezier(.55,0,.85,.45); }
    53.9% { transform: rotate(30deg) scale(1,1); animation-timing-function: cubic-bezier(.15,.55,.35,1); }
    59.4% { transform: rotate(40deg) scale(1,1); animation-timing-function: ease-in-out; }
    75.4% { transform: rotate(-6deg) scale(1,1); animation-timing-function: ease-out; }
    84.6% { transform: rotate(3deg) scale(1,1); animation-timing-function: ease-in-out; }
    93.7%, 100% { transform: rotate(0deg) scale(1,1); }
  }

  /* Back wing: a little higher, trailing the front wing slightly. */
  @keyframes tree-bird-flap-far {
    0%, 6.9% { transform: rotate(0deg) scale(1,1); animation-timing-function: ease-out; }
    13.7% { transform: rotate(-7deg) scale(1,1); animation-timing-function: cubic-bezier(.3,0,.2,1); }
    25.1% { transform: rotate(82deg) scale(.96,.86); animation-timing-function: cubic-bezier(.55,0,.85,.45); }
    28.8% { transform: rotate(50deg) scale(1,1); animation-timing-function: cubic-bezier(.15,.55,.35,1); }
    34.3% { transform: rotate(76deg) scale(.96,.86); animation-timing-function: cubic-bezier(.55,0,.85,.45); }
    37.9% { transform: rotate(48deg) scale(1,1); animation-timing-function: cubic-bezier(.15,.55,.35,1); }
    43.4% { transform: rotate(68deg) scale(.96,.86); animation-timing-function: cubic-bezier(.55,0,.85,.45); }
