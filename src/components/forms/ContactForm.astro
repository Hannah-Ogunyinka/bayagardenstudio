---
/**
 * Project enquiry form. Posts to the on-demand /api/contact/ endpoint, which
 * validates with Zod, verifies Turnstile and sends the enquiry through Amazon SES.
 * Works without JavaScript; with JavaScript it submits in place and announces the result.
 */
const services = [
  'Website Design and Development',
  'Email Marketing and Growth Strategy',
  'Website Maintenance',
  'Brand Photography',
  'Other',
] as const;
---

<form class="contact-form" method="post" action="/api/contact/" data-ajax-form novalidate>
  <div class="contact-form__row">
    <div class="field">
      <label for="contact-first-name">First name <span aria-hidden="true">*</span></label>
      <input id="contact-first-name" name="firstName" type="text" autocomplete="given-name" required />
    </div>
    <div class="field">
      <label for="contact-last-name">Last name <span aria-hidden="true">*</span></label>
      <input id="contact-last-name" name="lastName" type="text" autocomplete="family-name" required />
    </div>
  </div>

  <div class="field">
    <label for="contact-email">Email <span aria-hidden="true">*</span></label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required />
  </div>

  <fieldset class="contact-form__options">
    <legend>What would you like help with? <span aria-hidden="true">*</span></legend>
    {
      services.map((service, index) => (
        <div class="check">
          <input id={`contact-service-${index}`} type="checkbox" name="services" value={service} />
          <label for={`contact-service-${index}`}>{service}</label>
        </div>
      ))
    }
  </fieldset>

  <div class="field">
    <label for="contact-message">Message <span aria-hidden="true">*</span></label>
    <textarea id="contact-message" name="message" rows="4" required></textarea>
  </div>

  <!-- Honeypot: hidden from people, tempting to bots. -->
  <div class="hp" aria-hidden="true">
    <label for="contact-website">Leave this empty</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-theme="light"></div>

  <button type="submit">Submit form</button>
  <p class="contact-form__status" role="status" aria-live="polite" data-form-status></p>
  <p class="contact-form__note">Fields marked * are required.</p>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 0.8rem;
    font-family: var(--font-body);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;

    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .field {
    position: relative;
  }

  /* Labels sit inside the field like the original placeholders, but stay visible. */
  .field label {
    position: absolute;
    top: 0.6em;
    left: 1.6em;
    font-size: 0.7rem;
    letter-spacing: 0.04rem;
    text-transform: uppercase;
    pointer-events: none;
  }

  .field input,
  .field textarea {
    padding: 1.8em 1.6em 0.8em;
    border-radius: 8px;
  }

  .field input {
    height: 4em;
  }

  .contact-form__options {
    margin: 0;
    padding: 1.6em 1em;
    border: 0;
    border-radius: 8px;
    background-color: var(--color-white);
    font-size: var(--text-xs);
  }

  legend {
    float: left;
    width: 100%;
    margin-bottom: 1em;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-bottom: 0.6em;
    clear: both;
  }

  .check input {
    width: 1.1em;
    height: 1.1em;
    accent-color: var(--color-purple-dark);
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  button {
    width: 100%;
    height: 4em;
    border: 0;
    border-radius: var(--radius-button);
    background-color: var(--color-text);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04rem;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:hover {
    background-color: var(--color-grey-950);
  }

  .contact-form__status:empty {
    display: none;
  }

  .contact-form__status {
    margin: 0;
    padding: 0.8em 1em;
    border-radius: 8px;
    background-color: var(--color-white);
  }

  .contact-form__note {
    margin: 0;
    font-size: 0.75rem;
  }
</style>
