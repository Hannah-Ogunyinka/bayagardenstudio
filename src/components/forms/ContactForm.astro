---
/**
 * Project enquiry form. Posts to the on-demand /api/contact/ endpoint, which
 * validates with Zod, verifies Turnstile and sends the enquiry through Amazon SES.
 * With JavaScript (src/scripts/forms.ts) it submits in place and announces the result.
 * Without it the form still posts, but Turnstile needs JavaScript, so the
 * server explains and offers the email address instead.
 */
import { TURNSTILE_SITE_KEY } from '@config/site';
const services = [
  'Website Design and Development',
  'Email Marketing and Growth Strategy',
  'Website Maintenance',
  'Brand Photography',
  'Other',
] as const;
---

<form
  class="contact-form"
  method="post"
  action="/api/contact/"
  data-enhanced-form
  data-sitekey={TURNSTILE_SITE_KEY}
  data-invalid-message="Please fill in the fields marked as required, and choose at least one service."
  novalidate
>
  <div class="contact-form__row">
    <div class="field">
      <label for="contact-first-name">First name <span aria-hidden="true">*</span></label>
      <input id="contact-first-name" name="firstName" type="text" autocomplete="given-name" required placeholder=" " />
    </div>
    <div class="field">
      <label for="contact-last-name">Last name <span aria-hidden="true">*</span></label>
      <input id="contact-last-name" name="lastName" type="text" autocomplete="family-name" required placeholder=" " />
    </div>
  </div>

  <div class="field">
    <label for="contact-email">Email <span aria-hidden="true">*</span></label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required placeholder=" " />
  </div>

  <fieldset class="contact-form__options" data-require-one="services">
    <legend>What would you like help with? <span aria-hidden="true">*</span></legend>
    {
      services.map((service, index) => (
        <div class="check">
          <input id={`contact-service-${index}`} type="checkbox" name="services" value={service} />
          <label for={`contact-service-${index}`}>{service}</label>
        </div>
      ))
    }
  </fieldset>

  <div class="field">
    <label for="contact-message">Message <span aria-hidden="true">*</span></label>
    <textarea id="contact-message" name="message" rows="3" required placeholder=" "></textarea>
  </div>

  <!-- Honeypot: hidden from people, tempting to bots. -->
  <div class="hp" aria-hidden="true">
    <label for="contact-website">Leave this empty</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="contact-form__turnstile" data-turnstile></div>

  <button type="submit">Submit form</button>
  <p class="contact-form__status" role="status" aria-live="polite" data-form-status></p>
  <p class="contact-form__note">Fields marked * are required.</p>
</form>

<script>
  import { initForms } from '../../scripts/forms';
  initForms();
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem; /* token-exempt: live field spacing (20px) */
    font-family: var(--font-body);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem var(--stack-s); /* token-exempt: live field spacing (20px) */

    @media (--sm-down) {
      grid-template-columns: 1fr;
    }
  }

  .field {
    position: relative;
  }

  /*
   * Labels look like the live site's placeholders, inside the field. They stay
   * real labels, and shrink to the top edge once the field is focused or filled.
   */
  .field label {
    position: absolute;
    top: 50%;
    left: 1em;
    font-size: var(--text-field);
    text-transform: uppercase;
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      top 150ms,
      font-size 150ms,
      transform 150ms;
  }

  .field:has(textarea) label {
    top: 0.7em;
    transform: none;
  }

  .field:has(:focus) label,
  .field:has(input:not(:placeholder-shown), textarea:not(:placeholder-shown)) label {
    top: 0.45em;
    font-size: var(--text-micro);
    transform: none;
  }

  .field input,
  .field textarea {
    padding: 1.4em 0.95em 0.5em;
    border: var(--border-hairline) solid var(--color-white);
    border-radius: var(--radius-sm);
    font-size: var(--text-field);
  }

  .field input {
    height: 4rem; /* token-exempt: live field height (64px) */
  }

  .contact-form__options {
    margin: 0;
    padding: 1.6em 1em;
    border: 0;
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    font-size: var(--text-ui);
  }

  legend {
    float: left;
    width: 100%;
    margin-bottom: 1em;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-bottom: 1em;
    clear: both;
  }

  .check:last-child {
    margin-bottom: 0;
  }

  .check input {
    width: 0.9em;
    height: 0.9em;
    accent-color: var(--color-purple-dark);
  }

  .contact-form__turnstile:empty {
    display: none;
  }

  .field:has([aria-invalid='true']) input,
  .field:has([aria-invalid='true']) textarea,
  .contact-form__options[aria-invalid='true'] {
    outline: var(--border-thin) solid var(--color-purple-dark);
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  button {
    width: 100%;
    height: 4rem; /* token-exempt: live button height (64px) */
    border: 0;
    border-radius: var(--radius-button);
    background-color: var(--color-text);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--text-field);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:hover {
    background-color: var(--color-grey-950);
  }

  .contact-form__status:empty {
    display: none;
  }

  .contact-form__status {
    margin: 0;
    padding: 0.8em 1em;
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
  }

  .contact-form__note {
    margin: 0;
    font-size: var(--text-micro);
  }
</style>
