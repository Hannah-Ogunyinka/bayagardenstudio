---
import { getImage } from 'astro:assets';
import Stamp from '@assets/icons/stamp-mission.svg';
import desk from '@assets/images/home/mission-desk.jpg';

const background = await getImage({ src: desk, width: 1920, format: 'webp', quality: 82 });
---

<section class="mission" aria-labelledby="mission-title" style={`--mission-bg: url('${background.src}')`}>
  <div class="mission__overlay">
    <Stamp class="mission__stamp" aria-hidden="true" />
    <div class="mission__text">
      <p class="mission__eyebrow eyebrow">Our mission</p>
      <h2 id="mission-title">Elevating Brands, Simplifying Workflows, Unleashing Creativity</h2>
      <p>At Baya Garden Studio, website design and business automation is at the heart of what we do.</p>
      <p>
        We serve as your tech partners, sculpting your digital home and optimising your business processes, freeing you
        up to do what you do best: Create.
      </p>
    </div>
  </div>
</section>

<style>
  .mission {
    margin-inline: var(--inset-band);
    border-radius: 1em;
    background: var(--mission-bg) center / cover;
  }

  .mission__overlay {
    position: relative;
    display: flex;
    max-height: var(--hero-max-height);

    /* Past 1920px the live site lets the panel shrink to its content. */
    @media (--3xl-down) {
      min-height: 75vh;
    }

    align-items: center;
    justify-content: flex-end;
    padding: var(--space-xl) var(--space-md);
    border-radius: 1em;
    background-color: var(--color-tint-dark);

    @media (--md-down) {
      flex-direction: column;
      justify-content: center;
    }
  }

  .mission__stamp {
    position: absolute;
    bottom: var(--space-xl);
    left: var(--space-md);
    /* A fifth of the panel, as on the live site; never smaller than 6rem. */
    width: max(6rem, 20% - 2.2rem); /* token-exempt: stamp size from the live theme */
    color: var(--color-white);
    animation: rotate 7s linear infinite;

    @media (--md-down) {
      position: static;
      align-self: flex-start;
      margin-bottom: var(--space-md);
    }
  }

  @keyframes rotate {
    to {
      transform: rotate(360deg);
    }
  }

  .mission__text {
    flex: 0 0 40%;
    text-align: right;

    @media (--md-down) {
      flex-basis: auto;
    }
  }

  .mission p,
  .mission h2 {
    color: var(--color-white);
  }

  h2 {
    font-family: var(--font-heading);
    font-size: var(--text-h2-sm);
    font-weight: var(--weight-bold);
    line-height: 1.4;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .mission__text > p:not(.mission__eyebrow) {
    margin: 0;
  }

  /* The live site separates the two sentences with a blank line. */
  .mission__text > p + p {
    margin-top: calc(var(--leading-body) * 1em);
  }
</style>
