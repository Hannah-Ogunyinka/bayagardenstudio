---
import { Image } from 'astro:assets';
import WebDesignIcon from '@assets/icons/icon-web-design.svg';
import AnalyticsIcon from '@assets/icons/icon-analytics.svg';
import EmailIcon from '@assets/icons/icon-email-marketing.svg';
import template from '@assets/images/home/kimberley-template.webp';
import { MQ } from '@config/breakpoints';

const offers = [
  { Icon: WebDesignIcon, title: 'Conversion optimised web design', text: 'Cement your standing as a professional in your industry' },
  { Icon: AnalyticsIcon, title: 'Data analytics', text: 'Leverage data to make strategic decisions that accelerate business growth' },
  {
    Icon: EmailIcon,
    title: 'Email marketing',
    text: 'Build credibility, nurture relationships and yield high returns on investment with a focused email marketing strategy',
  },
];
---

<section class="offer" aria-labelledby="offer-title">
  <p class="eyebrow">Our offer</p>
  <h2 id="offer-title">Your trusted digital allies</h2>

  <div class="offer__columns">
    <div class="offer__list">
      <p>At Baya Garden Studio we focus on three solutions for business success:</p>
      <ul role="list">
        {
          offers.map(({ Icon, title, text }) => (
            <li>
              <Icon class="offer__icon" aria-hidden="true" width={30} height={30} />
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="offer__device">
    <Image
      src={template}
      alt="Example website design shown on a tablet: the Kimberley interior design theme"
      widths={[480, 720, 960]}
      sizes={`${MQ.mdDown} 100vw, 50vw`}
      class="offer__image"
    />
    </div>
  </div>
</section>

<style>
  .offer {
    padding: var(--space-md);

    @media (--lg-up) {
      padding-inline: calc(var(--space-md) + var(--indent));
    }
  }

  .offer > * {
    max-width: var(--container-content);
    margin-inline: auto;
  }

  .eyebrow {
    text-align: center;
  }

  h2 {
    margin-bottom: calc(2 * var(--space-md));
    font-family: var(--font-heading);
    font-size: var(--text-h2-alt);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    text-align: center;
  }

  .offer__columns {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-md) var(--space-xl);
    align-items: start;

    @media (--md-down) {
      grid-template-columns: 1fr;
    }
  }

  .offer__list {
    max-width: var(--measure-m);
  }

  .offer__list > p {
    margin: 0;
  }

  ul {
    max-width: 23em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-block: 1.5em;
    border-bottom: var(--border-hairline) solid var(--color-grey-400);
  }

  li > * + * {
    margin-top: var(--stack-s);
  }

  .offer__icon {
    display: block;
    width: var(--icon-offer);
    height: var(--icon-offer);
    color: var(--color-text);
  }

  h3 {
    margin-bottom: 0;
    font-family: var(--font-body);
    color: var(--color-text-muted);
    font-size: var(--text-lead);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-normal);
    text-transform: uppercase;
  }

  li p {
    margin: 0;
  }

  /* Dark tablet frame around the template screenshot. */
  .offer__device {
    padding: var(--space-sm);
    border-radius: var(--radius-showcase);
    background-color: var(--color-surface-inverse);
    box-shadow: var(--shadow-footer);
  }

  .offer__image {
    width: 100%;
    border-radius: var(--radius-media);
  }
</style>
