---
import { Image } from 'astro:assets';
import CategoryTag from '@components/posts/CategoryTag.astro';
import { getPosts, postUrl } from '@lib/content';

const [post] = await getPosts();
---

{
  post && (
    <section class="featured" aria-labelledby="featured-title">
      <h2 id="featured-title" class="featured__eyebrow">Featured post</h2>
      <article class="featured__card">
        <div class="featured__text">
          {post.data.categories[0] && <CategoryTag name={post.data.categories[0]} />}
          <h3>
            <a href={postUrl(post)}>{post.data.title}</a>
          </h3>
        </div>
        <Image src={post.data.image.src} alt="" widths={[480, 800, 1200]} sizes="(max-width: 782px) 100vw, 55vw" />
      </article>
    </section>
  )
}

<style>
  .featured {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-xl) var(--space-md) var(--space-lg);
  }

  .featured__eyebrow {
    margin-bottom: var(--space-md);
    padding-block: 0.6rem;
    border-block: 1px solid var(--color-grey-200);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .featured__card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-md);

    @media (max-width: 782px) {
      grid-template-columns: 1fr;
    }
  }

  .featured__text :global(.category-tag) {
    position: relative;
    z-index: 1;
  }

  h3 {
    margin-top: 0.6rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.25;
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .featured__card:hover h3 a {
    color: var(--color-purple);
  }

  .featured__card :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
  }
</style>
