---
/**
 * Full-screen menu that slides down from the top when "Menu" is pressed and
 * rises back up on "Close". Behaviour lives in src/scripts/menu.ts.
 *
 * Accessibility: modal dialog semantics, focus moves into the menu and is
 * trapped there, Escape closes it, and focus returns to the Menu button.
 */
import NewsletterForm from '@components/forms/NewsletterForm.astro';
import MailIcon from '@assets/icons/icon-mail.svg';
import LinkedInIcon from '@assets/icons/icon-linkedin.svg';
import { MAIN_MENU, SITE } from '@config/site';

const currentPath = Astro.url.pathname;
let order = 1;
---

<div class="menu-shim" data-menu-shim hidden></div>
<div
  id="site-menu"
  class="menu"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  data-menu
  hidden
>
  <div class="menu__bar">
    <button type="button" class="menu__close" data-menu-close>Close</button>
  </div>

  <div class="menu__columns">
    <nav class="menu__nav" aria-label="Main">
      <ul class="menu__list">
        {
          MAIN_MENU.map((item) => (
            <li style={`--order: ${++order}`}>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
              {item.children && (
                <ul class="menu__sublist">
                  {item.children.map((child) => (
                    <li style={`--order: ${++order}`}>
                      <a href={child.href} aria-current={currentPath === child.href ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu__aside">
      <p class="menu__subscribe"><span class="accent">Subscribe</span> today for valuable tips on running your digital empire</p>
      <NewsletterForm id="menu-newsletter" layout="stacked" />
      <hr class="menu__rule" />
      <h2 class="menu__connect-title">Connect</h2>
      <ul class="menu__social" role="list">
        <li>
          <a href={`mailto:${SITE.email}`} aria-label="Email Baya Garden Studio">
            <MailIcon aria-hidden="true" width={23} />
          </a>
        </li>
        <li>
          <a href={SITE.linkedIn} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
            <LinkedInIcon aria-hidden="true" width={20} />
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset-inline: 0;
    top: -100%;
    z-index: var(--z-menu);
    padding-block: var(--space-sm) var(--space-md);
    border-radius: 0 0 var(--radius-pill) var(--radius-pill);
    background-color: var(--color-grey-100);
    font-family: var(--font-heading);

    @media (max-width: 960px) {
      border-radius: 0;
    }

    @media (max-width: 420px) {
      height: 100dvh;
      overflow-y: auto;
    }
  }

  .menu[data-state='open'] {
    animation: slide-down var(--duration-menu) ease-in-out forwards;
  }

  .menu[data-state='closing'] {
    animation: slide-up var(--duration-menu) ease-in-out forwards;
  }

  @keyframes slide-down {
    from {
      top: -100%;
    }
    to {
      top: 0;
    }
  }

  @keyframes slide-up {
    from {
      top: 0;
    }
    to {
      top: -100%;
    }
  }

  .menu-shim {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu-shim);
    background-color: rgb(0 0 0 / 33%);
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .menu-shim[data-state='open'] {
    opacity: 1;
  }

  .menu__bar {
    display: flex;
    justify-content: flex-end;
    padding-inline: var(--space-md);
  }

  .menu__close {
    padding: 1.2em 2.8em;
    border: 2px solid var(--color-text);
    border-radius: var(--radius-button);
    background-color: var(--color-text);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05rem;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu__close:hover {
    background-color: var(--color-grey-950);
  }

  .menu__columns {
    display: flex;
    flex-wrap: wrap;

    > * {
      flex: 1 1 50%;
      min-width: min(100%, 320px);
      padding: var(--space-md) var(--space-md) 0;
    }
  }

  .menu__list,
  .menu__sublist {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__list {
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.5;
  }

  .menu__list li {
    opacity: 0;
    animation: expand-in var(--ease-menu) 500ms forwards;
    animation-delay: calc(var(--order) * 70ms);
  }

  .menu__list > li {
    border-bottom: 1px solid #d2d2d2;
  }

  .menu__list > li:has(.menu__sublist) {
    border-bottom: 0;
  }

  .menu__list a {
    display: inline-block;
    padding-block: 0.2em;
    color: var(--color-text);
    text-decoration: none;
  }

  .menu__list a:hover,
  .menu__list > li:has(.menu__sublist) > a {
    color: var(--color-purple);
  }

  .menu__list a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .menu__sublist {
    border-top: 1px solid #d2d2d2;
  }

  .menu__sublist li {
    padding-left: 1em;
    border-bottom: 1px solid #d2d2d2;
  }

  .menu__sublist a:hover {
    color: var(--color-purple);
  }

  .menu__aside {
    opacity: 0;
    animation: fade-in var(--ease-menu) 700ms 300ms forwards;
  }

  .menu__subscribe {
    margin-bottom: var(--space-sm);
    font-size: var(--text-md);
    font-weight: 700;
  }

  .accent {
    color: var(--color-purple);
  }

  .menu__rule {
    height: 0;
    margin-block: var(--space-sm);
    border: 0;
    border-bottom: 1px solid var(--color-purple);
  }

  .menu__connect-title {
    margin-bottom: 0.4em;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    text-transform: none;
  }

  .menu__social {
    display: flex;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;

    a {
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      border-radius: 50%;
      background-color: var(--color-text);
      color: var(--color-grey-100);
    }

    a:hover {
      background-color: var(--color-purple);
    }

    :global(svg) {
      width: 20px;
      fill: currentColor;
    }
  }

  @keyframes expand-in {
    0% {
      opacity: 0;
      transform: scale(0.8);
    }
    75% {
      opacity: 0.4;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade-in {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    75% {
      opacity: 0.4;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
</style>
