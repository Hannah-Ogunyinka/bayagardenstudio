---
/**
 * Sticky-feeling top bar: logo, site title, primary call to action and Menu button.
 * The menu overlay itself is rendered by MenuOverlay.astro.
 */
import Button from '@components/ui/Button.astro';
import MenuOverlay from './MenuOverlay.astro';
import LogoMark from '@assets/icons/logo-mark.svg';
import { SITE } from '@config/site';

const isHome = Astro.url.pathname === '/';
---

<MenuOverlay />

<header class="site-header" data-inert-when-menu-open>
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-current={isHome ? 'page' : undefined}>
      <LogoMark class="site-header__logo" aria-hidden="true" width={50} height={50} />
      <span class="site-header__title hide-mobile">{SITE.name}</span>
      <span class="sr-only">{SITE.name} home</span>
    </a>

    <div class="site-header__actions">
      <Button href="/contact/" variant="fill" arrow class="hide-mobile hide-tablet">Start your project today</Button>
      <button
        type="button"
        class="site-header__menu-button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-open
      >
        Menu
      </button>
    </div>
  </div>
</header>

<script>
  import { initMenu } from '../../scripts/menu';
  initMenu();
</script>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    padding: var(--space-sm) var(--space-md);
    backdrop-filter: blur(5px);
  }

  .site-header__inner {
    display: flex;
    max-width: var(--content-max);
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__logo {
    width: 50px;
    height: 50px;
  }

  .site-header__title {
    font-family: var(--font-heading);
    font-size: var(--text-logo);
    font-weight: 600;
  }

  /* When both the visible title and sr-only text exist, avoid announcing the name twice. */
  .site-header__title + .sr-only {
    display: none;
  }

  @media (max-width: 600px) {
    .site-header__title + .sr-only {
      display: initial;
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .site-header__menu-button {
    padding: 1.2em 2.8em;
    border: 2px solid var(--color-purple);
    border-radius: var(--radius-button);
    background-color: rgb(235 235 235 / 44%);
    backdrop-filter: blur(5px);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05rem;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.2s ease-in-out,
      color 0.2s ease-in-out;
  }

  .site-header__menu-button:hover {
    background-color: var(--color-purple);
    color: var(--color-white);
  }
</style>
