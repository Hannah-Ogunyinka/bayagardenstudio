---
/**
 * Pill button link used across the site.
 * - "fill": solid green (primary call to action)
 * - "outline": purple outline (secondary, e.g. Menu / Close)
 * - "dark": dark grey fill (newsletter, contact submit)
 */
import Arrow from '@assets/icons/arrow.svg';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'fill' | 'outline' | 'purple' | 'light' | 'ghost' | 'dark';
  arrow?: boolean;
};

const { href, variant = 'fill', arrow = false, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, className]} {...rest}>
  <span><slot /></span>
  {arrow && <Arrow class="button__icon" aria-hidden="true" width={18} height={18} />}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 1.2em 1.6em;
    border: 2px solid transparent;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.05rem;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color 0.2s ease-in-out,
      color 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out;
  }

  .button--fill {
    border-color: var(--color-green);
    background-color: var(--color-green);
    color: var(--color-white);
  }

  .button--fill:hover {
    box-shadow: var(--shadow-float);
  }

  .button--outline {
    padding-inline: 2.8em;
    border-color: var(--color-purple);
    background-color: rgb(235 235 235 / 44%);
    color: var(--color-text);
    font-weight: 500;
  }

  .button--outline:hover {
    background-color: var(--color-purple);
    color: var(--color-white);
  }

  .button--purple {
    border-color: var(--color-purple);
    background-color: var(--color-purple);
    color: var(--color-white);
  }

  .button--light {
    border-color: var(--color-grey-100);
    background-color: var(--color-grey-100);
    color: var(--color-text);
  }

  .button--light:hover {
    background-color: var(--color-white);
  }

  .button--ghost {
    border-color: var(--color-grey-100);
    background-color: transparent;
    color: var(--color-white);
  }

  .button--ghost:hover {
    background-color: var(--color-grey-100);
    color: var(--color-text);
  }

  .button--dark {
    padding: 0.9em 1.4em;
    border-color: var(--color-text);
    background-color: var(--color-text);
    color: var(--color-white);
  }

  .button--dark:hover {
    background-color: var(--color-grey-950);
  }

  .button__icon {
    width: 18px;
    flex: none;
  }
</style>
