---
/** Dark rounded call-to-action panel used at the foot of several pages. */
import Button from './Button.astro';

interface Props {
  title?: string;
  href?: string;
  label?: string;
}

const { title = 'Start building your digital home today', href = '/contact/', label = 'Start your project' } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <h2 id="cta-title">{title}</h2>
  <Button href={href} variant="fill">{label}</Button>
</section>

<style>
  .cta {
    display: grid;
    max-width: calc(var(--content-max) - 2 * var(--space-md));
    margin: var(--space-xl) var(--space-md) var(--space-lg);
    padding: var(--space-lg) var(--space-md);
    justify-items: center;
    gap: var(--space-md);
    border-radius: 1em;
    background-color: var(--color-text);
    text-align: center;

    @media (min-width: 1921px) {
      margin-inline: auto;
    }
  }

  h2 {
    max-width: 14em;
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-2xl-alt);
    font-weight: 600;
    line-height: 1.2;
    text-transform: none;
  }
</style>
