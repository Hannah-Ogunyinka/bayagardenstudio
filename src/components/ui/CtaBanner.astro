---
/** Dark rounded call-to-action panel used at the foot of several pages. */
import Button from './Button.astro';

interface Props {
  title?: string;
  href?: string;
  label?: string;
  /** "small" for a sentence-length message. */
  size?: 'large' | 'small';
}

const {
  title = 'Start building your digital home today',
  href = '/contact/',
  label = 'Start your project',
  size = 'large',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <h2 id="cta-title" class:list={[`cta__title--${size}`]}>{title}</h2>
  <Button href={href} variant="fill">{label}</Button>
</section>

<style>
  .cta {
    display: grid;
    max-width: calc(var(--container-wide) - 2 * var(--space-md));
    margin: var(--space-md);
    padding: var(--space-md) var(--space-sm);
    justify-items: center;
    gap: var(--space-md);
    border-radius: 1em;
    background-color: var(--color-text);
    text-align: center;

    @media (--3xl-up) {
      margin-inline: auto;
    }
  }

  h2 {
    max-width: var(--measure-cta);
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-tight);
    text-transform: none;
  }

  .cta__title--small {
    max-width: 32em;
    font-family: var(--font-body);
    font-size: var(--text-ui);
    font-weight: 400;
    line-height: 1.6;
  }
</style>
