---
import { Image } from 'astro:assets';
import avatar from '@assets/images/authors/hannah-ogunyinka.png';
---

<aside class="author" aria-label="About the author">
  <Image src={avatar} alt="" width={64} height={64} class="author__avatar" />
  <div>
    <p class="author__label">Article written by</p>
    <p class="author__name">Hannah Ogunyinka</p>
    <p class="author__bio">
      Freelance developer and photographer from London. An ex Primary school teacher of 15 years, Hannah is still
      passionate about education and loves to share how to build effective spaces on the web with small businesses.
    </p>
  </div>
</aside>

<style>
  .author {
    display: flex;
    max-width: var(--measure-xs);
    margin: var(--space-lg) auto 0;
    padding: 1.6em; /* 19px at the 12px box text */
    gap: 1.33em;
    border-radius: var(--radius-sm);
    background-color: var(--color-grey-950);
    font-size: var(--text-micro);
  }

  .author p {
    margin: 0 0 0.4em;
    color: var(--color-white);
  }

  .author__avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex: none;
    border-radius: 50%;
  }

  .author__name {
    font-size: var(--text-ui);
    font-weight: 600;
  }
</style>
